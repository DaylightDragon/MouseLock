{
  "schemaVersion": 1,
  "id": "mouselock",
  "version": "${version}",
  "name": "Mouse Lock",
  "description": "Toggle mouse locking to assist you with repetitive tasks where you need to go in a straight line, such as farming, planting crops when already aligned to an angle.",
  "authors": [
    "D4ylight"
  ],
  "contact": {
    "sources": "https://github.com/DaylightDragon/MouseLock"
  },
  "license": "MIT",
  "icon": "assets/mouselock/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "org.daylight.fabric.MouseLockFabric"
    ],
    "client": [
      "org.daylight.fabric.client.MouseLockFabricClient"
    ],
    "modmenu": [
      "org.daylight.fabric.client.MouseLockModMenu"
    ]
  },
  "mixins": [
    "mouselock.mixins.json"
  ],
  "depends": {
    "fabricloader": "*",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*",
    "forgeconfigapiport": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
